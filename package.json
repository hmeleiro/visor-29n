{
  "name": "visor-escrutinio-29n",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite --config vite.config.ts\"",
    "build:data": "tsx scripts/preprocess-history.ts",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "tsup server/index.ts --format esm --platform node --target node22 --out-dir dist/server --clean --sourcemap",
    "build": "npm run build:data && npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@fontsource-variable/inter": "^5.3.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "echarts": "^6.1.0",
    "fastify": "^5.12.8",
    "mysql2": "^3.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
