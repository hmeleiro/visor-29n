# MySQL. En Docker Compose, DB_HOST se obtiene del HOSTNAME del .env actual.
DB_HOST=db.example.internal
DB_PORT=3306
DB_NAME=escrutinio
DB_USER=visor_readonly
DB_PASSWORD=change-me

# Compatibilidad con el fichero actual (preferir DB_HOST en despliegues nuevos).
# HOSTNAME=db.example.internal
# DBPASS=change-me

DASHBOARD_USER=operador
DASHBOARD_PASSWORD=change-me
PORT=3000
POLL_INTERVAL_MS=2000
EXPECTED_TERRITORY_ROWS=53

